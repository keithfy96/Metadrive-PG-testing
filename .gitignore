.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/

# Banks are disposable, per-batch artifacts -- regenerate rather than commit. See README,
# "What gets generated, and where".
# banks/

# The studio's job logs and scratch figures (Phase 2c). Derived from runs that already
# happened; a job is re-runnable, so none of this is worth keeping.
.studio/

# Results written by `docker compose run --rm run ... --out /out/...`, and by `scenariobank run`
# from a terminal: a relative `--out` lands under out/ (since 2026-09-10, after fourteen run
# directories had been committed from the repo root). The directory itself is tracked
# (out/.gitkeep) because the Docker daemon creates a missing bind source as root; what lands in
# it is a run's output and belongs with the run, not in git.
out/*
!out/.gitkeep
